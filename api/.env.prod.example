# API Production Environment Configuration (.env.prod.example)
NODE_ENV=production
PORT=3000

# Database & Redis
DATABASE_URL=postgresql://postgres:replace_with_a_strong_database_password@postgres:5432/waitlistos?schema=public
DATABASE_HOST=postgres
DATABASE_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Domains
FRONTEND_URL=https://getlist.learnica.net
CORS_ORIGINS=https://getlist.learnica.net,https://www.getlist.learnica.net
NEXT_PUBLIC_APP_URL=https://getlist.learnica.net

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_jwt_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_jwt_refresh_secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://getlist.learnica.net/api/auth/google/callback

# Resend
RESEND_API_KEY=
EMAIL_FROM=notifications@getlist.learnica.net

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chapa & Stripe
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLIENT_ID=
PLATFORM_FEE_PERCENTAGE=10

# Plans
PLAN_CURRENCY=USD
FREE_MAX_WAITLISTS=1
FREE_MAX_PARTICIPANTS=500
PLAN_STARTER_PRICE=19
PLAN_STARTER_MAX_WAITLISTS=5
PLAN_STARTER_MAX_PARTICIPANTS=5000
PLAN_PRO_PRICE=49

MAXMIND_DB_PATH=./GeoLite2-Country.mmdb
