  @@map("team_invitations")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TeamRewardMilestone â€” Configured by Founder
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model TeamRewardMilestone {
  id         String     @id @default(uuid())
  waitlistId String
  milestone  Int
  type       RewardType
  value      Int?
  valueType  String?    @default("fixed")
  title      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  waitlist             Waitlist              @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  teamMilestoneRewards TeamMilestoneReward[]

  @@unique([waitlistId, milestone])
  @@map("team_reward_milestones")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TeamMilestoneReward â€” Unlocked by a team
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model TeamMilestoneReward {
  id                    String   @id @default(uuid())
  teamId                String
  teamRewardMilestoneId String
  unlockedAt            DateTime @default(now())

  team               Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestone          TeamRewardMilestone     @relation(fields: [teamRewardMilestoneId], references: [id], onDelete: Cascade)
  participantRewards TeamParticipantReward[]

  @@unique([teamId, teamRewardMilestoneId])
  @@map("team_milestone_rewards")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TeamParticipantReward â€” Granted to a member
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model TeamParticipantReward {
  id                    String   @id @default(uuid())
  teamMilestoneRewardId String
  participantId         String
  unlockedAt            DateTime @default(now())

  teamMilestoneReward TeamMilestoneReward @relation(fields: [teamMilestoneRewardId], references: [id], onDelete: Cascade)
  participant         Participant         @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamMilestoneRewardId, participantId])
  @@map("team_participant_rewards")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AttributionVisit â€” Anonymous analytics tracking
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model AttributionVisit {
  id         String        @id @default(uuid())
  waitlistId String
  sessionId  String
  source     TrafficSource
  medium     String?
  campaign   String?
  timestamp  DateTime      @default(now())

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@index([waitlistId, source])
  @@index([waitlistId, timestamp])
  @@index([waitlistId, sessionId])
  @@map("attribution_visits")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// FunnelEvent â€” Anonymous conversion funnel tracking
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model FunnelEvent {
  id         String          @id @default(uuid())
  waitlistId String
  sessionId  String
  eventType  FunnelEventType
  createdAt  DateTime        @default(now())

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@index([waitlistId])
  @@index([waitlistId, eventType])
  @@index([waitlistId, createdAt])
  @@index([waitlistId, sessionId, eventType])
  @@map("funnel_events")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// DailyFunnelStats â€” Aggregated daily funnel statistics
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model DailyFunnelStats {
  id         String          @id @default(uuid())
  waitlistId String
  date       DateTime        @db.Date
  eventType  FunnelEventType
  count      Int             @default(0)
  updatedAt  DateTime        @updatedAt

  @@unique([waitlistId, date, eventType])
  @@index([waitlistId, date])
  @@map("daily_funnel_stats")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// GrowthTimeseries â€” Signup growth time series data
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model GrowthTimeseries {
  id          String           @id @default(uuid())
  waitlistId  String
  periodStart DateTime
  periodType  GrowthPeriodType
  signupCount Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@unique([waitlistId, periodStart, periodType])
  @@index([waitlistId, periodStart])
  @@index([waitlistId, periodType, periodStart])
  @@map("growth_timeseries")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ReferralSpike â€” Detected viral referral moments
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ReferralSpike {
  id                    String   @id @default(uuid())
  waitlistId            String
  referrerParticipantId String
  startAt               DateTime
  endAt                 DateTime
  signupCount           Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  waitlist Waitlist    @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  referrer Participant @relation("ReferrerSpikes", fields: [referrerParticipantId], references: [id])

  @@index([waitlistId, startAt])
  @@index([waitlistId, referrerParticipantId])
  @@index([waitlistId, endAt])
  @@map("referral_spikes")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PaymentAccount â€” Founder's connected payment provider accounts
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model PaymentAccount {
  id                String               @id @default(uuid())
  founderId         String
  provider          PaymentProvider
  providerAccountId String?
  status            PaymentAccountStatus @default(NOT_CONNECTED)
  connectedAt       DateTime?
  lastError         String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  founder          Founder           @relation(fields: [founderId], references: [id], onDelete: Cascade)
  affiliatePayouts AffiliatePayout[]

  @@unique([founderId, provider])
  @@map("payment_accounts")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MonetizationPayment â€” Generic transaction model for waitlist features
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model MonetizationPayment {
  id                String                    @id @default(uuid())
  founderId         String
  waitlistId        String
  participantId     String?
  provider          PaymentProvider
  providerPaymentId String                    @unique
  paymentType       MonetizationPaymentType
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String
  platformFee       Decimal                   @db.Decimal(12, 2)
  providerFee       Decimal                   @db.Decimal(12, 2)
  founderAmount     Decimal                   @db.Decimal(12, 2)
  status            MonetizationPaymentStatus @default(PENDING)
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  founder     Founder      @relation(fields: [founderId], references: [id], onDelete: Cascade)
  waitlist    Waitlist     @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  events           MonetizationPaymentEvent[]
  preOrderDeposits PreOrderDeposit[]

  @@index([founderId])
  @@index([waitlistId])
  @@index([participantId])
  @@index([status])
  @@map("monetization_payments")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MonetizationPaymentEvent â€” Webhook idempotency and audit log
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model MonetizationPaymentEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  paymentId       String?
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  payment MonetizationPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("monetization_payment_events")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PreOrderDeposit â€” Tracks the deposit lifecycle
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model PreOrderDeposit {
  id                    String                @id @default(uuid())
  waitlistId            String
  participantId         String
  monetizationPaymentId String?
  amount                Decimal               @db.Decimal(12, 2)
  currency              String
  provider              PaymentProvider
  status                PreOrderDepositStatus @default(PENDING)
  policy                PreOrderDepositPolicy

  paidAt      DateTime?
  refundedAt  DateTime? // Historical only - for external provider refunds (no manual refund functionality)
  collectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  waitlist            Waitlist             @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  participant         Participant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  monetizationPayment MonetizationPayment? @relation(fields: [monetizationPaymentId], references: [id], onDelete: SetNull)

  @@index([waitlistId])
  @@index([participantId])
  @@index([status])
  @@map("pre_order_deposits")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Affiliate Program Enums
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AffiliateAttributionStatus {
  ACTIVE
  CONVERTED
  EXPIRED
}

enum AffiliateConversionStatus {
  PENDING
  CONFIRMED
  REVERSED // Historical status only - conversion reversal functionality removed
}

enum AffiliateCommissionStatus {
  PENDING
  ELIGIBLE
  PAID
  REVERSED // Historical status only - commission reversal functionality removed
}

enum AffiliatePayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Affiliate â€” A founder participating in the affiliate program
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Affiliate {
  id String @id @default(uuid())

  founderId String @unique

  /// Unique, URL-safe affiliate code (e.g. ABC123)
  code String @unique

  status AffiliateStatus @default(ACTIVE)

  clickCount              Int              @default(0)
  preferredPayoutProvider PaymentProvider?

  /// Commission rate as a decimal (e.g. 0.20 = 20%)
  commissionRate Decimal @default(0.20) @db.Decimal(5, 4)

  /// How many months commissions are earned per referred founder
  commissionDurationMonths Int @default(12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  clicks       AffiliateClick[]
  attributions AffiliateAttribution[]
  conversions  AffiliateConversion[]
  commissions  AffiliateCommission[]
  payouts      AffiliatePayout[]

  @@index([code])
  @@map("affiliates")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AffiliateClick â€” A single tracked referral click
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AffiliateClick {
  id String @id @default(uuid())

  affiliateId String

  /// Privacy-safe opaque session identifier (not raw IP)
  sessionToken String?

  /// Hashed IP for fraud detection only (SHA-256 of IP, never raw)
  ipHash String?

  /// Device type string e.g. desktop/mobile (from UA parser)
  deviceType String?

  /// Country code from geo-lookup (e.g. ET, US)
  countryCode String?

  createdAt DateTime @default(now())

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  attribution AffiliateAttribution?

  @@index([affiliateId])
  @@index([createdAt])
  @@map("affiliate_clicks")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AffiliateAttribution â€” Associates a new founder with an affiliate
//
// Attribution policy: 30-day last-valid-affiliate.
// The attribution is created at founder registration and never silently
// overwritten. If a founder registers after the 30-day cookie window,
// no attribution is created.
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AffiliateAttribution {
  id String @id @default(uuid())

  affiliateId       String
  referredFounderId String @unique // one active attribution per founder

  affiliateClickId String? @unique

  status AffiliateAttributionStatus @default(ACTIVE)

  attributedAt DateTime @default(now())

  /// 30 days after the click that created this attribution
  expiresAt DateTime

  affiliate       Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredFounder Founder         @relation("AffiliateAttributionFounder", fields: [referredFounderId], references: [id], onDelete: Cascade)
  click           AffiliateClick? @relation(fields: [affiliateClickId], references: [id], onDelete: SetNull)

  conversions AffiliateConversion[]

  @@index([affiliateId])
  @@index([status])
  @@map("affiliate_attributions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AffiliateConversion â€” A payment that triggered a commission
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AffiliateConversion {
  id String @id @default(uuid())

  affiliateId       String
  referredFounderId String
  attributionId     String

  /// Internal Payment record that triggered this conversion
  sourcePaymentId String @unique

  status AffiliateConversionStatus @default(PENDING)

  convertedAt DateTime @default(now())

  affiliate       Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredFounder Founder              @relation("AffiliateConversionFounder", fields: [referredFounderId], references: [id], onDelete: Cascade)
  attribution     AffiliateAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)

  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@index([referredFounderId])
  @@index([status])
  @@map("affiliate_conversions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AffiliateCommission â€” A single commission record (or reversal)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AffiliateCommission {
  id String @id @default(uuid())

  affiliateId       String
  referredFounderId String
  conversionId      String

  /// The subscription Payment this commission is derived from
  sourcePaymentId String

  /// Commission amount
  amount Decimal @db.Decimal(12, 2)

  currency String

  /// Rate applied at the time of earning, e.g. 0.20
  commissionRate Decimal @db.Decimal(5, 4)

  status AffiliateCommissionStatus @default(PENDING)

  /// Commission becomes ELIGIBLE after this date (14-day settlement window for payment processing, verification, and fraud prevention)
  eligibleAt DateTime?

  /// When this commission was included in a payout
  paidAt DateTime?

  /// Which payout record paid this commission
  payoutId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliate       Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredFounder Founder             @relation("AffiliateCommissionFounder", fields: [referredFounderId], references: [id], onDelete: Cascade)
  conversion      AffiliateConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  payout          AffiliatePayout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
  @@index([referredFounderId])
  @@index([sourcePaymentId])
  @@index([status, eligibleAt])
  @@map("affiliate_commissions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AffiliatePayout â€” A single payout transfer attempt
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AffiliatePayout {
  id String @id @default(uuid())

  affiliateId     String
  payoutAccountId String

  provider PaymentProvider

  amount   Decimal @db.Decimal(12, 2)
  currency String

  status AffiliatePayoutStatus @default(PENDING)

  /// Payout covers commissions earned in this period
  periodStart DateTime
  periodEnd   DateTime

  /// Provider-side transfer/payout ID
  providerTransactionId String?

  /// Deterministic idempotency key: affiliateId + periodStart formatted
  idempotencyKey String @unique

  failureReason String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliate     Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payoutAccount PaymentAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Cascade)

  commissions AffiliateCommission[]

  @@index([affiliateId, status])
  @@index([idempotencyKey])
  @@map("affiliate_payouts")
}
