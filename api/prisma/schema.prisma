model Payment {
  id String @id @default(uuid())

  subscriptionId String?

  userId String

  planCode SubscriptionPlanCode

  amount Decimal @db.Decimal(12, 2)

  currency String

  provider PaymentProvider @default(CHAPA)

  providerReference String @unique

  transactionId String? @unique

  paymentStatus PaymentStatus @default(PENDING)

  checkoutUrl String?

  metadata Json?

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  events PaymentEvent[]

  @@index([userId, paymentStatus])
  @@map("payments")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// PaymentEvent â€” Webhook / verification audit log

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PaymentEvent {
  id String @id @default(uuid())

  paymentId String

  eventType PaymentEventType

  payload Json

  processed Boolean @default(false)

  idempotencyKey String @unique

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// SubscriptionHistory â€” Plan/status change audit

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SubscriptionHistory {
  id String @id @default(uuid())

  subscriptionId String

  userId String

  fromPlan SubscriptionPlanCode?

  toPlan SubscriptionPlanCode

  fromStatus SubscriptionStatus?

  toStatus SubscriptionStatus

  reason String?

  metadata Json?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@map("subscription_history")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Reward â€” A milestone reward defined by a founder
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Reward {
  id          String     @id @default(uuid())
  waitlistId  String
  milestone   Int
  type        RewardType
  value       Int?
  valueType   String?    @default("fixed")
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  waitlist           Waitlist            @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  participantRewards ParticipantReward[]

  @@unique([waitlistId, milestone])
  @@map("rewards")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ParticipantReward â€” A reward unlocked by a participant
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ParticipantReward {
  id            String   @id @default(uuid())
  participantId String
  rewardId      String
  unlockedAt    DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  reward      Reward      @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([participantId, rewardId])
  @@map("participant_rewards")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// StreakMilestone â€” A consecutive day referral reward milestone
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model StreakMilestone {
  id          String     @id @default(uuid())
  waitlistId  String
  days        Int
  type        RewardType
  value       Int?
  valueType   String?    @default("fixed")
  title       String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  waitlist                 Waitlist                  @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  participantStreakRewards ParticipantStreakReward[]

  @@unique([waitlistId, days])
  @@map("streak_milestones")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ParticipantStreakReward â€” A streak reward unlocked by a participant
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ParticipantStreakReward {
  id                String   @id @default(uuid())
  participantId     String
  streakMilestoneId String
  unlockedAt        DateTime @default(now())

  participant     Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  streakMilestone StreakMilestone @relation(fields: [streakMilestoneId], references: [id], onDelete: Cascade)

  @@unique([participantId, streakMilestoneId])
  @@map("participant_streak_rewards")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Cohort â€” A batch of invited participants
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Cohort {
  id          String   @id @default(uuid())
  waitlistId  String
  batchNumber Int // Cohort #1, #2, #3, etc.
  size        Int // Number of participants invited
  createdAt   DateTime @default(now())

  waitlist    Waitlist           @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  invitations CohortInvitation[]

  @@unique([waitlistId, batchNumber])
  @@index([waitlistId])
  @@map("cohorts")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CohortInvitation â€” Participant invited in a cohort
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model CohortInvitation {
  id            String   @id @default(uuid())
  cohortId      String
  participantId String
  invitedAt     DateTime @default(now())

  cohort      Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([cohortId, participantId])
  @@index([participantId])
  @@map("cohort_invitations")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AiLog â€” Track all AI usage
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AiLog {
  id        String   @id @default(uuid())
  userId    String?
  feature   String
  prompt    String   @db.Text
  response  String   @db.Text
  provider  String
  model     String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("ai_logs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// WaitlistCopy â€” Current live copy for a waitlist (AI Copywriter)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model WaitlistCopy {
  id          String   @id @default(uuid())
  waitlistId  String   @unique
  headline    String
  subheadline String
  cta         String
  features    Json // [{title: string, description: string}] x3
  faqs        Json // [{question: string, answer: string}] x5
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  waitlist Waitlist              @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  versions WaitlistCopyVersion[]

  @@map("waitlist_copies")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// WaitlistCopyVersion â€” Append-only version history for AI copy
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model WaitlistCopyVersion {
  id          String   @id @default(uuid())
  copyId      String
  headline    String
  subheadline String
  cta         String
  features    Json
  faqs        Json
  createdAt   DateTime @default(now())

  copy WaitlistCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)

  @@index([copyId])
  @@map("waitlist_copy_versions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ParticipantReferralMessage â€” AI Generated sharing texts
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ParticipantReferralMessage {
  id            String   @id @default(uuid())
  participantId String   @unique
  twitter       String   @db.Text
  linkedin      String   @db.Text
  whatsapp      String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_referral_messages")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ParticipantEngagement â€” Dropout Prediction
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ParticipantEngagement {
  id              String    @id @default(uuid())
  participantId   String    @unique
  riskScore       Int
  riskLevel       RiskLevel
  lastEvaluatedAt DateTime  @default(now())
  lastEmailedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_engagements")
}

model ParticipantEngagementLog {
  id            String    @id @default(uuid())
  participantId String
  riskScore     Int
  riskLevel     RiskLevel
  evaluatedAt   DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("participant_engagement_logs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Team â€” Collaborative referrals
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Team {
  id          String   @id @default(uuid())
  waitlistId  String
  name        String
  ownerId     String
  inviteCode  String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  waitlist             Waitlist              @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  owner                Participant           @relation("TeamOwner", fields: [ownerId], references: [id])
  members              Participant[]         @relation("TeamMembers")
  invitations          TeamInvitation[]
