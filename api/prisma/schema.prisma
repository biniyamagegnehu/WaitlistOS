// This is your Prisma schema file,

// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Enums

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum Role {
  USER

  ADMIN
}

enum Provider {
  EMAIL

  GOOGLE
}

enum UserStatus {
  PENDING_VERIFICATION

  ACTIVE

  SUSPENDED
}

enum FileProvider {
  CLOUDINARY
}

enum SubscriptionPlanCode {
  FREE

  STARTER

  PRO
}

enum SubscriptionStatus {
  ACTIVE

  INACTIVE

  PENDING

  CANCELLED

  EXPIRED

  PAST_DUE
}

enum BillingCycle {
  FREE

  MONTHLY
}

enum PaymentProvider {
  CHAPA

  STRIPE
}

enum PaymentStatus {
  PENDING

  SUCCESS

  FAILED

  CANCELLED
}

enum PaymentEventType {
  INITIALIZED

  WEBHOOK_RECEIVED

  VERIFIED

  FAILED

  CANCELLED

  DUPLICATE
}

enum RewardType {
  POSITION_BOOST

  EARLY_ACCESS

  VIP_ACCESS

  DISCOUNT

  CUSTOM
}

enum ParticipantStatus {
  WAITING

  INVITED

  ACCESSED
}

enum SignupStatus {
  PARTIAL

  COMPLETED
}

enum RiskLevel {
  HEALTHY

  MEDIUM_RISK

  HIGH_RISK
}

enum TrafficSource {
  DIRECT
  TWITTER
  WHATSAPP
  INSTAGRAM
  EMAIL
  PRODUCT_HUNT
  LINKEDIN
  FACEBOOK
  TELEGRAM
  GOOGLE
  OTHER
  UNKNOWN
}

enum FunnelEventType {
  PAGE_VISIT
  FORM_FOCUS
  SIGNUP_SUBMITTED
  REFERRAL_SHARED
  EMAIL_SUBMITTED
  QUESTIONS_STARTED
  QUESTIONS_COMPLETED
  SIGNUP_COMPLETED
  REFERRAL_STEP_VIEWED
}

enum GrowthPeriodType {
  HOUR
  DAY
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum PaymentAccountStatus {
  NOT_CONNECTED
  PENDING
  ACTION_REQUIRED
  ACTIVE
  RESTRICTED
  DISCONNECTED
  ERROR
}

enum MonetizationPaymentType {
  SKIP_LINE
  PRE_ORDER_DEPOSIT
}

enum MonetizationPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED // Historical status for external provider refunds only
}

enum PreOrderDepositPolicy {
  REFUNDABLE // Historical only - refund functionality removed
  CREDIT_TOWARD_PURCHASE
}

enum PreOrderDepositStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING // Historical status only - refund functionality removed
  REFUNDED     // Historical status only - for external provider refunds
  COLLECTION_PENDING
  COLLECTED
  CANCELLED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// User â€” Authentication identity

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String?

  firstName String?

  lastName String?

  avatar String?

  role Role @default(USER)

  provider Provider @default(EMAIL)

  status UserStatus @default(PENDING_VERIFICATION)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // â”€â”€ Email Verification â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  emailVerifiedAt DateTime?

  emailVerificationToken String?

  emailVerificationExpiresAt DateTime?

  // â”€â”€ Password Reset â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  passwordResetToken String?

  passwordResetExpiresAt DateTime?

  passwordChangedAt DateTime?

  // â”€â”€ Email Change â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  pendingEmail String?

  pendingEmailVerificationToken String?

  pendingEmailVerificationExpiresAt DateTime?

  // â”€â”€ Two-Factor Authentication (TOTP) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  twoFactorEnabled Boolean @default(false)

  twoFactorSecret String?

  // â”€â”€ Account Lockout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  sessions Session[]

  founder Founder?

  files File[]

  subscription Subscription?

  payments Payment[]

  aiLogs AiLog[]

  @@map("users")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Session â€” Refresh token tracking per device

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Session {
  id String @id @default(uuid())

  userId String

  refreshTokenHash String

  ipAddress String?

  userAgent String?

  expiresAt DateTime

  lastUsedAt DateTime @default(now())

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Founder â€” Business entity, owns Waitlists

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Founder {
  id String @id @default(uuid())

  userId String @unique

  email String @unique

  name String?

  // Company Profile
  companyName         String?
  industry            String?
  companyDescription  String?
  country             String?
  teamSize            String?
  companyLogo         String?
  companyWebsite      String?
  billingEmail        String?
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  waitlists            Waitlist[]
  paymentAccounts      PaymentAccount[]
  monetizationPayments MonetizationPayment[]

  // â”€â”€ Affiliate Program â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  affiliate                     Affiliate?
  affiliateAttributionAsReferee AffiliateAttribution[] @relation("AffiliateAttributionFounder")
  affiliateConversionsAsReferee AffiliateConversion[]  @relation("AffiliateConversionFounder")
  affiliateCommissionsAsReferee AffiliateCommission[]  @relation("AffiliateCommissionFounder")

  @@map("founders")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// File â€” Uploaded file metadata (not binary)

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model File {
  id String @id @default(uuid())

  publicId String

  url String

  secureUrl String

  originalName String

  fileName String

  mimeType String

  format String

  bytes Int

  width Int?

  height Int?

  folder String

  provider FileProvider @default(CLOUDINARY)

  uploadedByUserId String

  createdAt DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  waitlistLogos Waitlist[] @relation("WaitlistLogo")

  brandingLogos Branding[] @relation("BrandingLogo")

  @@index([uploadedByUserId])
  @@map("files")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Waitlist â€” A single waitlist owned by a Founder

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Waitlist {
  id String @id @default(uuid())

  founderId String

  name String

  tagline String

  description String?

  slug String @unique

  logoId String?

  // â”€â”€ Double-Sided Rewards â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  doubleSidedRewardsEnabled              Boolean @default(false)
  referrerRankingBonus                   Int     @default(5)
  newParticipantRankingBonus             Int     @default(2)
  doubleSidedRewardsGranted              Int     @default(0)
  totalReferrerRankingBonusAwarded       Int     @default(0)
  totalNewParticipantRankingBonusAwarded Int     @default(0)

  // â”€â”€ Streak Bonuses â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  streakBonusesEnabled Boolean @default(false)

  // â”€â”€ Team Referrals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  teamReferralsEnabled Boolean @default(false)
  maxTeamSize          Int     @default(10)

  // â”€â”€ Urgency Engine â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  urgencyEnabled     Boolean   @default(false)
  batchEnabled       Boolean   @default(false)
  batchName          String?
  batchSize          Int?
  batchDescription   String?
  countdownEnabled   Boolean   @default(false)
  launchDate         DateTime?
  showRemainingSpots Boolean   @default(true)
  showBatchProgress  Boolean   @default(true)
  showCountdown      Boolean   @default(true)

  // â”€â”€ Skip the Line (Paid Priority) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  skipLineEnabled  Boolean  @default(false)
  skipLinePrice    Decimal? @db.Decimal(12, 2)
  skipLineCurrency String?

  // â”€â”€ Pre-Order Deposit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  preOrderDepositEnabled     Boolean                @default(false)
  preOrderDepositAmount      Decimal?               @db.Decimal(12, 2)
  preOrderDepositCurrency    String?

  preOrderDepositDescription String?

  // â”€â”€ Appearance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  themeMode ThemeMode @default(SYSTEM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  logo File? @relation("WaitlistLogo", fields: [logoId], references: [id], onDelete: SetNull)

  branding Branding?

  widget Widget?

  participants Participant[]

  rewards Reward[]

  streakMilestones StreakMilestone[]

  teams                Team[]
  teamRewardMilestones TeamRewardMilestone[]

  cohorts Cohort[]

  copy WaitlistCopy?

  pageConfig WaitlistPageConfig?

  signupConfig WaitlistSignupConfig?

  attributionVisits AttributionVisit[]

  funnelEvents FunnelEvent[]

  growthTimeseries GrowthTimeseries[]

  referralSpikes       ReferralSpike[]
  monetizationPayments MonetizationPayment[]
  preOrderDeposits     PreOrderDeposit[]

  @@index([founderId])
  @@map("waitlists")
}

model WaitlistPageConfig {
  id              String   @id @default(uuid())
  waitlistId      String   @unique
  draftConfig     Json
  publishedConfig Json?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@map("waitlist_page_configs")
}

model WaitlistSignupConfig {
  id         String   @id @default(uuid())
  waitlistId String   @unique
  enabled                  Boolean  @default(false)
  steps                    Json     @default("[]")
  createdAt                DateTime @default(now())
  updatedAt  DateTime @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@map("waitlist_signup_configs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Branding â€” Visual identity for a waitlist

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Branding {
  id String @id @default(uuid())

  waitlistId String @unique

  logoId String?

  primaryColor String

  secondaryColor String

  backgroundColor String

  buttonColor String

  font String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  logo File? @relation("BrandingLogo", fields: [logoId], references: [id], onDelete: SetNull)

  @@map("brandings")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Widget â€” Embed metadata for a waitlist

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Widget {
  id String @id @default(uuid())

  waitlistId String @unique

  scriptUrl String

  embedCode String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Participant â€” A user who joined a waitlist

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Participant {
  id String @id @default(uuid())

  waitlistId String

  email String

  position Int

  referralCode String @unique

  referredById String?

  referralCount Int @default(0)

  positionBoostBonus Int @default(0)

  hasSkipLinePriority       Boolean   @default(false)
  skipLinePriorityGrantedAt DateTime?

  currentStreak Int @default(0)

  longestStreak Int @default(0)

  lastSuccessfulReferralAt DateTime?

  teamId String?

  status ParticipantStatus @default(WAITING)

  invitedAt DateTime?

  accessedAt DateTime?

  emailVerified        Boolean   @default(false)
  accessTokenHash      String?
  accessTokenCreatedAt DateTime?
  accessTokenRevokedAt DateTime?

  signupStatus SignupStatus @default(COMPLETED)

  customFields Json?

  // â”€â”€ Source Attribution â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  source      TrafficSource?
  medium      String?
  campaign    String?
  referrer    String?
  landingPath String?

  // â”€â”€ Geo & Device Analytics â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  ipAddress   String?
  countryCode String?
  deviceType  String?
  browserName String?

  lastPositionUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  referredBy Participant? @relation("Referrals", fields: [referredById], references: [id])

  referrals Participant[] @relation("Referrals")

  participantRewards ParticipantReward[]

  participantStreakRewards ParticipantStreakReward[]

  cohortInvitations CohortInvitation[]

  referralMessage ParticipantReferralMessage?

  engagement ParticipantEngagement?

  engagementLogs ParticipantEngagementLog[]

  team                   Team?                   @relation("TeamMembers", fields: [teamId], references: [id])
  ownedTeams             Team[]                  @relation("TeamOwner")
  teamInvitations        TeamInvitation[]
  teamParticipantRewards TeamParticipantReward[]

  referralSpikes       ReferralSpike[]       @relation("ReferrerSpikes")
  monetizationPayments MonetizationPayment[]
  preOrderDeposits     PreOrderDeposit[]

  @@unique([waitlistId, email])
  @@index([waitlistId, status])
  @@index([waitlistId, createdAt])
  @@index([waitlistId, countryCode, createdAt])
  @@index([waitlistId, deviceType, createdAt])
  @@index([waitlistId, browserName, createdAt])
  @@map("participants")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// SubscriptionPlan â€” Configurable plan catalog

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SubscriptionPlan {
  id String @id @default(uuid())

  code SubscriptionPlanCode @unique

  name String

  description String?

  price Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("ETB")

  billingCycle BillingCycle

  maxWaitlists Int?

  maxParticipants Int?

  features Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Subscription â€” Founder's active plan

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Subscription {
  id String @id @default(uuid())

  userId String @unique

  planId String

  planCode SubscriptionPlanCode

  status SubscriptionStatus @default(ACTIVE)

  billingCycle BillingCycle @default(FREE)

  amount Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("ETB")

  provider PaymentProvider?

  providerReference String?

  transactionId String?

  paymentStatus PaymentStatus?

  startedAt DateTime?

  expiresAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  payments Payment[]

  history SubscriptionHistory[]

  @@index([planCode, status])
  @@map("subscriptions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

