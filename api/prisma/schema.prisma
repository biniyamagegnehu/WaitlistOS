// This is your Prisma schema file,

// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────

// Enums

// ─────────────────────────────────────────────

enum Role {
  USER

  ADMIN
}

enum Provider {
  EMAIL

  GOOGLE
}

enum UserStatus {
  PENDING_VERIFICATION

  ACTIVE

  SUSPENDED
}

enum FileProvider {
  CLOUDINARY
}

enum SubscriptionPlanCode {
  FREE

  STARTER

  PRO
}

enum SubscriptionStatus {
  ACTIVE

  INACTIVE

  PENDING

  CANCELLED

  EXPIRED

  PAST_DUE
}

enum BillingCycle {
  FREE

  MONTHLY
}

enum PaymentProvider {
  CHAPA

  STRIPE
}

enum PaymentStatus {
  PENDING

  SUCCESS

  FAILED

  CANCELLED
}

enum PaymentEventType {
  INITIALIZED

  WEBHOOK_RECEIVED

  VERIFIED

  FAILED

  CANCELLED

  DUPLICATE
}

enum RewardType {
  POSITION_BOOST

  EARLY_ACCESS

  VIP_ACCESS

  DISCOUNT

  CUSTOM
}

enum ParticipantStatus {
  WAITING

  INVITED

  ACCESSED
}

enum RiskLevel {
  HEALTHY

  MEDIUM_RISK

  HIGH_RISK
}

enum TrafficSource {
  DIRECT
  TWITTER
  WHATSAPP
  INSTAGRAM
  EMAIL
  PRODUCT_HUNT
  LINKEDIN
  FACEBOOK
  GOOGLE
  OTHER
  UNKNOWN
}

enum FunnelEventType {
  PAGE_VISIT
  FORM_FOCUS
  SIGNUP_SUBMITTED
  REFERRAL_SHARED
}

enum GrowthPeriodType {
  HOUR
  DAY
}

// ─────────────────────────────────────────────

// User — Authentication identity

// ─────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String?

  firstName String?

  lastName String?

  avatar String?

  role Role @default(USER)

  provider Provider @default(EMAIL)

  status UserStatus @default(PENDING_VERIFICATION)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ── Email Verification ──────────────────────────

  emailVerifiedAt DateTime?

  emailVerificationToken String?

  emailVerificationExpiresAt DateTime?

  // ── Password Reset ──────────────────────────────

  passwordResetToken String?

  passwordResetExpiresAt DateTime?

  passwordChangedAt DateTime?

  // ── Email Change ────────────────────────────────

  pendingEmail String?

  pendingEmailVerificationToken String?

  pendingEmailVerificationExpiresAt DateTime?

  // ── Two-Factor Authentication (TOTP) ────────────

  twoFactorEnabled Boolean @default(false)

  twoFactorSecret String?

  // ── Account Lockout ─────────────────────────────

  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  sessions Session[]

  founder Founder?

  files File[]

  subscription Subscription?

  payments Payment[]

  aiLogs AiLog[]

  @@map("users")
}

// ─────────────────────────────────────────────

// Session — Refresh token tracking per device

// ─────────────────────────────────────────────

model Session {
  id String @id @default(uuid())

  userId String

  refreshTokenHash String

  ipAddress String?

  userAgent String?

  expiresAt DateTime

  lastUsedAt DateTime @default(now())

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─────────────────────────────────────────────

// Founder — Business entity, owns Waitlists

// ─────────────────────────────────────────────

model Founder {
  id String @id @default(uuid())

  userId String @unique

  email String @unique

  name String?

  // Company Profile
  companyName         String?
  industry            String?
  companyDescription  String?
  country             String?
  teamSize            String?
  companyLogo         String?
  companyWebsite      String?
  billingEmail        String?
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  waitlists Waitlist[]

  @@map("founders")
}

// ─────────────────────────────────────────────

// File — Uploaded file metadata (not binary)

// ─────────────────────────────────────────────

model File {
  id String @id @default(uuid())

  publicId String

  url String

  secureUrl String

  originalName String

  fileName String

  mimeType String

  format String

  bytes Int

  width Int?

  height Int?

  folder String

  provider FileProvider @default(CLOUDINARY)

  uploadedByUserId String

  createdAt DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  waitlistLogos Waitlist[] @relation("WaitlistLogo")

  brandingLogos Branding[] @relation("BrandingLogo")

  @@index([uploadedByUserId])
  @@map("files")
}

// ─────────────────────────────────────────────

// Waitlist — A single waitlist owned by a Founder

// ─────────────────────────────────────────────

model Waitlist {
  id String @id @default(uuid())

  founderId String

  name String

  tagline String

  description String?

  slug String @unique

  logoId String?

  // ── Double-Sided Rewards ────────────────────
  doubleSidedRewardsEnabled              Boolean @default(false)
  referrerRankingBonus                   Int     @default(5)
  newParticipantRankingBonus             Int     @default(2)
  doubleSidedRewardsGranted              Int     @default(0)
  totalReferrerRankingBonusAwarded       Int     @default(0)
  totalNewParticipantRankingBonusAwarded Int     @default(0)

  // ── Streak Bonuses ──────────────────────────
  streakBonusesEnabled Boolean @default(false)

  // ── Team Referrals ──────────────────────────
  teamReferralsEnabled Boolean @default(false)
  maxTeamSize          Int     @default(10)

  // ── Urgency Engine ──────────────────────────
  urgencyEnabled     Boolean   @default(false)
  batchEnabled       Boolean   @default(false)
  batchName          String?
  batchSize          Int?
  batchDescription   String?
  countdownEnabled   Boolean   @default(false)
  launchDate         DateTime?
  showRemainingSpots Boolean   @default(true)
  showBatchProgress  Boolean   @default(true)
  showCountdown      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  logo File? @relation("WaitlistLogo", fields: [logoId], references: [id], onDelete: SetNull)

  branding Branding?

  widget Widget?

  participants Participant[]

  rewards Reward[]

  streakMilestones StreakMilestone[]

  teams                Team[]
  teamRewardMilestones TeamRewardMilestone[]

  cohorts Cohort[]

  copy WaitlistCopy?

  attributionVisits AttributionVisit[]

  funnelEvents FunnelEvent[]

  growthTimeseries GrowthTimeseries[]

  referralSpikes ReferralSpike[]

  @@index([founderId])
  @@map("waitlists")
}

// ─────────────────────────────────────────────

// Branding — Visual identity for a waitlist

// ─────────────────────────────────────────────

model Branding {
  id String @id @default(uuid())

  waitlistId String @unique

  logoId String?

  primaryColor String

  secondaryColor String

  backgroundColor String

  buttonColor String

  font String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  logo File? @relation("BrandingLogo", fields: [logoId], references: [id], onDelete: SetNull)

  @@map("brandings")
}

// ─────────────────────────────────────────────

// Widget — Embed metadata for a waitlist

// ─────────────────────────────────────────────

model Widget {
  id String @id @default(uuid())

  waitlistId String @unique

  scriptUrl String

  embedCode String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

// ─────────────────────────────────────────────

// Participant — A user who joined a waitlist

// ─────────────────────────────────────────────

model Participant {
  id String @id @default(uuid())

  waitlistId String

  email String

  position Int

  referralCode String @unique

  referredById String?

  referralCount Int @default(0)

  positionBoostBonus Int @default(0)

  currentStreak Int @default(0)

  longestStreak Int @default(0)

  lastSuccessfulReferralAt DateTime?

  teamId String?

  status ParticipantStatus @default(WAITING)

  invitedAt DateTime?

  accessedAt DateTime?

  // ── Source Attribution ───────────────────────
  source      TrafficSource?
  medium      String?
  campaign    String?
  referrer    String?
  landingPath String?

  // ── Geo & Device Analytics ─────────────────────
  countryCode String?
  deviceType  String?
  browserName String?

  lastPositionUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  referredBy Participant? @relation("Referrals", fields: [referredById], references: [id])

  referrals Participant[] @relation("Referrals")

  participantRewards ParticipantReward[]

  participantStreakRewards ParticipantStreakReward[]

  cohortInvitations CohortInvitation[]

  referralMessage ParticipantReferralMessage?

  engagement ParticipantEngagement?

  engagementLogs ParticipantEngagementLog[]

  team                   Team?                   @relation("TeamMembers", fields: [teamId], references: [id])
  ownedTeams             Team[]                  @relation("TeamOwner")
  teamInvitations        TeamInvitation[]
  teamParticipantRewards TeamParticipantReward[]

  referralSpikes         ReferralSpike[]          @relation("ReferrerSpikes")

  @@unique([waitlistId, email])
  @@index([waitlistId, status])
  @@index([waitlistId, createdAt])
  @@index([waitlistId, countryCode, createdAt])
  @@index([waitlistId, deviceType, createdAt])
  @@index([waitlistId, browserName, createdAt])
  @@map("participants")
}

// ─────────────────────────────────────────────

// SubscriptionPlan — Configurable plan catalog

// ─────────────────────────────────────────────

model SubscriptionPlan {
  id String @id @default(uuid())

  code SubscriptionPlanCode @unique

  name String

  description String?

  price Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("ETB")

  billingCycle BillingCycle

  maxWaitlists Int?

  maxParticipants Int?

  features Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ─────────────────────────────────────────────

// Subscription — Founder's active plan

// ─────────────────────────────────────────────

model Subscription {
  id String @id @default(uuid())

  userId String @unique

  planId String

  planCode SubscriptionPlanCode

  status SubscriptionStatus @default(ACTIVE)

  billingCycle BillingCycle @default(FREE)

  amount Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("ETB")

  provider PaymentProvider?

  providerReference String?

  transactionId String?

  paymentStatus PaymentStatus?

  startedAt DateTime?

  expiresAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  payments Payment[]

  history SubscriptionHistory[]

  @@index([planCode, status])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────

// Payment — Individual Chapa transactions

// ─────────────────────────────────────────────

model Payment {
  id String @id @default(uuid())

  subscriptionId String?

  userId String

  planCode SubscriptionPlanCode

  amount Decimal @db.Decimal(12, 2)

  currency String

  provider PaymentProvider @default(CHAPA)

  providerReference String @unique

  transactionId String? @unique

  paymentStatus PaymentStatus @default(PENDING)

  checkoutUrl String?

  metadata Json?

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  events PaymentEvent[]

  @@index([userId, paymentStatus])
  @@map("payments")
}

// ─────────────────────────────────────────────

// PaymentEvent — Webhook / verification audit log

// ─────────────────────────────────────────────

model PaymentEvent {
  id String @id @default(uuid())

  paymentId String

  eventType PaymentEventType

  payload Json

  processed Boolean @default(false)

  idempotencyKey String @unique

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

// ─────────────────────────────────────────────

// SubscriptionHistory — Plan/status change audit

// ─────────────────────────────────────────────

model SubscriptionHistory {
  id String @id @default(uuid())

  subscriptionId String

  userId String

  fromPlan SubscriptionPlanCode?

  toPlan SubscriptionPlanCode

  fromStatus SubscriptionStatus?

  toStatus SubscriptionStatus

  reason String?

  metadata Json?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@map("subscription_history")
}

// ─────────────────────────────────────────────
// Reward — A milestone reward defined by a founder
// ─────────────────────────────────────────────

model Reward {
  id          String     @id @default(uuid())
  waitlistId  String
  milestone   Int
  type        RewardType
  value       Int?
  valueType   String?    @default("fixed")
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  waitlist           Waitlist            @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  participantRewards ParticipantReward[]

  @@unique([waitlistId, milestone])
  @@map("rewards")
}

// ─────────────────────────────────────────────
// ParticipantReward — A reward unlocked by a participant
// ─────────────────────────────────────────────

model ParticipantReward {
  id            String   @id @default(uuid())
  participantId String
  rewardId      String
  unlockedAt    DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  reward      Reward      @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([participantId, rewardId])
  @@map("participant_rewards")
}

// ─────────────────────────────────────────────
// StreakMilestone — A consecutive day referral reward milestone
// ─────────────────────────────────────────────

model StreakMilestone {
  id          String     @id @default(uuid())
  waitlistId  String
  days        Int
  type        RewardType
  value       Int?
  valueType   String?    @default("fixed")
  title       String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  waitlist                 Waitlist                  @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  participantStreakRewards ParticipantStreakReward[]

  @@unique([waitlistId, days])
  @@map("streak_milestones")
}

// ─────────────────────────────────────────────
// ParticipantStreakReward — A streak reward unlocked by a participant
// ─────────────────────────────────────────────

model ParticipantStreakReward {
  id                String   @id @default(uuid())
  participantId     String
  streakMilestoneId String
  unlockedAt        DateTime @default(now())

  participant     Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  streakMilestone StreakMilestone @relation(fields: [streakMilestoneId], references: [id], onDelete: Cascade)

  @@unique([participantId, streakMilestoneId])
  @@map("participant_streak_rewards")
}

// ─────────────────────────────────────────────
// Cohort — A batch of invited participants
// ─────────────────────────────────────────────
model Cohort {
  id          String   @id @default(uuid())
  waitlistId  String
  batchNumber Int // Cohort #1, #2, #3, etc.
  size        Int // Number of participants invited
  createdAt   DateTime @default(now())

  waitlist    Waitlist           @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  invitations CohortInvitation[]

  @@unique([waitlistId, batchNumber])
  @@index([waitlistId])
  @@map("cohorts")
}

// ─────────────────────────────────────────────
// CohortInvitation — Participant invited in a cohort
// ─────────────────────────────────────────────
model CohortInvitation {
  id            String   @id @default(uuid())
  cohortId      String
  participantId String
  invitedAt     DateTime @default(now())

  cohort      Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([cohortId, participantId])
  @@index([participantId])
  @@map("cohort_invitations")
}

// ─────────────────────────────────────────────
// AiLog — Track all AI usage
// ─────────────────────────────────────────────

model AiLog {
  id        String   @id @default(uuid())
  userId    String?
  feature   String
  prompt    String   @db.Text
  response  String   @db.Text
  provider  String
  model     String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("ai_logs")
}

// ─────────────────────────────────────────────
// WaitlistCopy — Current live copy for a waitlist (AI Copywriter)
// ─────────────────────────────────────────────

model WaitlistCopy {
  id          String   @id @default(uuid())
  waitlistId  String   @unique
  headline    String
  subheadline String
  cta         String
  features    Json // [{title: string, description: string}] x3
  faqs        Json // [{question: string, answer: string}] x5
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  waitlist Waitlist              @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  versions WaitlistCopyVersion[]

  @@map("waitlist_copies")
}

// ─────────────────────────────────────────────
// WaitlistCopyVersion — Append-only version history for AI copy
// ─────────────────────────────────────────────

model WaitlistCopyVersion {
  id          String   @id @default(uuid())
  copyId      String
  headline    String
  subheadline String
  cta         String
  features    Json
  faqs        Json
  createdAt   DateTime @default(now())

  copy WaitlistCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)

  @@index([copyId])
  @@map("waitlist_copy_versions")
}

// ─────────────────────────────────────────────
// ParticipantReferralMessage — AI Generated sharing texts
// ─────────────────────────────────────────────
model ParticipantReferralMessage {
  id            String   @id @default(uuid())
  participantId String   @unique
  twitter       String   @db.Text
  linkedin      String   @db.Text
  whatsapp      String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_referral_messages")
}

// ─────────────────────────────────────────────
// ParticipantEngagement — Dropout Prediction
// ─────────────────────────────────────────────
model ParticipantEngagement {
  id              String    @id @default(uuid())
  participantId   String    @unique
  riskScore       Int
  riskLevel       RiskLevel
  lastEvaluatedAt DateTime  @default(now())
  lastEmailedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_engagements")
}

model ParticipantEngagementLog {
  id            String    @id @default(uuid())
  participantId String
  riskScore     Int
  riskLevel     RiskLevel
  evaluatedAt   DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("participant_engagement_logs")
}

// ─────────────────────────────────────────────
// Team — Collaborative referrals
// ─────────────────────────────────────────────
model Team {
  id          String   @id @default(uuid())
  waitlistId  String
  name        String
  ownerId     String
  inviteCode  String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  waitlist             Waitlist              @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  owner                Participant           @relation("TeamOwner", fields: [ownerId], references: [id])
  members              Participant[]         @relation("TeamMembers")
  invitations          TeamInvitation[]
  teamMilestoneRewards TeamMilestoneReward[]

  @@unique([waitlistId, name])
  @@map("teams")
}

// ─────────────────────────────────────────────
// TeamInvitation — Direct invites
// ─────────────────────────────────────────────
model TeamInvitation {
  id            String   @id @default(uuid())
  teamId        String
  participantId String
  status        String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt     DateTime @default(now())

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@map("team_invitations")
}

// ─────────────────────────────────────────────
// TeamRewardMilestone — Configured by Founder
// ─────────────────────────────────────────────
model TeamRewardMilestone {
  id         String     @id @default(uuid())
  waitlistId String
  milestone  Int
  type       RewardType
  value      Int?
  valueType  String?    @default("fixed")
  title      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  waitlist             Waitlist              @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  teamMilestoneRewards TeamMilestoneReward[]

  @@unique([waitlistId, milestone])
  @@map("team_reward_milestones")
}

// ─────────────────────────────────────────────
// TeamMilestoneReward — Unlocked by a team
// ─────────────────────────────────────────────
model TeamMilestoneReward {
  id                    String   @id @default(uuid())
  teamId                String
  teamRewardMilestoneId String
  unlockedAt            DateTime @default(now())

  team               Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestone          TeamRewardMilestone     @relation(fields: [teamRewardMilestoneId], references: [id], onDelete: Cascade)
  participantRewards TeamParticipantReward[]

  @@unique([teamId, teamRewardMilestoneId])
  @@map("team_milestone_rewards")
}

// ─────────────────────────────────────────────
// TeamParticipantReward — Granted to a member
// ─────────────────────────────────────────────
model TeamParticipantReward {
  id                    String   @id @default(uuid())
  teamMilestoneRewardId String
  participantId         String
  unlockedAt            DateTime @default(now())

  teamMilestoneReward TeamMilestoneReward @relation(fields: [teamMilestoneRewardId], references: [id], onDelete: Cascade)
  participant         Participant         @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamMilestoneRewardId, participantId])
  @@map("team_participant_rewards")
}

// ─────────────────────────────────────────────
// AttributionVisit — Anonymous analytics tracking
// ─────────────────────────────────────────────
model AttributionVisit {
  id         String        @id @default(uuid())
  waitlistId String
  sessionId  String
  source     TrafficSource
  medium     String?
  campaign   String?
  timestamp  DateTime      @default(now())

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@index([waitlistId, source])
  @@index([waitlistId, timestamp])
  @@index([waitlistId, sessionId])
  @@map("attribution_visits")
}

// ─────────────────────────────────────────────
// FunnelEvent — Anonymous conversion funnel tracking
// ─────────────────────────────────────────────
model FunnelEvent {
  id        String         @id @default(uuid())
  waitlistId String
  sessionId String
  eventType FunnelEventType
  createdAt DateTime       @default(now())

  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@index([waitlistId])
  @@index([waitlistId, eventType])
  @@index([waitlistId, createdAt])
  @@index([waitlistId, sessionId, eventType])
  @@map("funnel_events")
}

// ─────────────────────────────────────────────
// DailyFunnelStats — Aggregated daily funnel statistics
// ─────────────────────────────────────────────
model DailyFunnelStats {
  id        String         @id @default(uuid())
  waitlistId String
  date      DateTime       @db.Date
  eventType FunnelEventType
  count      Int           @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([waitlistId, date, eventType])
  @@index([waitlistId, date])
  @@map("daily_funnel_stats")
}

// ─────────────────────────────────────────────
// GrowthTimeseries — Signup growth time series data
// ─────────────────────────────────────────────
model GrowthTimeseries {
  id          String          @id @default(uuid())
  waitlistId  String
  periodStart DateTime
  periodType  GrowthPeriodType
  signupCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  waitlist    Waitlist        @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@unique([waitlistId, periodStart, periodType])
  @@index([waitlistId, periodStart])
  @@index([waitlistId, periodType, periodStart])
  @@map("growth_timeseries")
}

// ─────────────────────────────────────────────
// ReferralSpike — Detected viral referral moments
// ─────────────────────────────────────────────
model ReferralSpike {
  id                  String   @id @default(uuid())
  waitlistId          String
  referrerParticipantId String
  startAt             DateTime
  endAt               DateTime
  signupCount         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  waitlist            Waitlist   @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  referrer            Participant @relation("ReferrerSpikes", fields: [referrerParticipantId], references: [id])

  @@index([waitlistId, startAt])
  @@index([waitlistId, referrerParticipantId])
  @@index([waitlistId, endAt])
  @@map("referral_spikes")
}
