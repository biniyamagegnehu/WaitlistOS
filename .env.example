# ==============================================================================
# WaitlistOS Root Environment Configuration (LOCAL / DEVELOPMENT)
# File: .env.example
# ==============================================================================

# --- Ports ---
FRONTEND_PORT=3060
BACKEND_PORT=4060
DATABASE_PORT=5436
REDIS_PORT=6384

# --- Environment & URLs ---
NODE_ENV=development
FRONTEND_DOMAIN=http://localhost:3060
NEXT_PUBLIC_APP_URL=http://localhost:3060
NEXT_PUBLIC_API_URL=http://localhost:4060
CORS_ORIGINS=http://localhost:3060,http://localhost:3000,http://localhost:3001

# --- PostgreSQL Database ---
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_dev_password
DATABASE_NAME=waitlistos_dev
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5436/waitlistos_dev?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6384
REDIS_URL=redis://localhost:6384

# --- Authentication ---
JWT_ACCESS_SECRET=local_jwt_access_secret_change_me
JWT_REFRESH_SECRET=local_jwt_refresh_secret_change_me

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4060/api/auth/google/callback

# --- Resend Email ---
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Payments ---
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your_chapa_public
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
CHAPA_BASE_URL=https://api.chapa.co/v1

STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CLIENT_ID=ca_your_stripe_client_id
PLATFORM_FEE_PERCENTAGE=10

# --- Subscription Plans ---
PLAN_CURRENCY=USD
FREE_MAX_WAITLISTS=1
FREE_MAX_PARTICIPANTS=500
PLAN_STARTER_PRICE=19
PLAN_STARTER_MAX_WAITLISTS=5
PLAN_STARTER_MAX_PARTICIPANTS=5000
PLAN_PRO_PRICE=49

# --- Geolocation ---
MAXMIND_DB_PATH=./GeoLite2-Country.mmdb
